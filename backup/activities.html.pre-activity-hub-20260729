<meta name="description" content="Explore the education, family support, holistic wellness and women's self-reliance initiatives of Yugpravartak Shri Nandkishore Sharda Mission.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,400&family=Karla:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/css/style.css">
<style>
  :root{
    --ink:#241B2E;
    --parchment:#F7F1E6;
    --parchment-2:#F0E8D8;
    --flame:#C1552C;
    --flame-bright:#E07A45;
    --gold:#A9832F;
    --teal:#1E3A34;
    --muted:#6B5F52;
    --cream-text:#EFE7D8;
    --max:1120px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Karla',sans-serif; background:var(--parchment); color:var(--ink);
    line-height:1.65; -webkit-font-smoothing:antialiased;
  }
  a{color:inherit; text-decoration:none;}
  :focus-visible{outline:2px solid var(--flame); outline-offset:4px;}
  .wrap{max-width:var(--max); margin:0 auto; padding:0 32px;}

  .initiatives-hero{
    position:relative; overflow:hidden; padding:154px 0 86px;
    background:
      radial-gradient(circle at 18% 20%, rgba(193,85,44,.13), transparent 34%),
      radial-gradient(circle at 84% 80%, rgba(169,131,47,.14), transparent 36%),
      linear-gradient(180deg,var(--parchment),var(--parchment-2));
    text-align:center;
  }
  .initiatives-hero::before{
    content:''; position:absolute; width:460px; height:460px; border:1px solid rgba(169,131,47,.14);
    border-radius:50%; left:50%; top:46%; transform:translate(-50%,-50%); pointer-events:none;
  }
  .hero-content{position:relative; z-index:1; max-width:820px; margin:0 auto;}
  .eyebrow{
    display:block; font-family:'Cinzel',serif; font-size:11px; letter-spacing:.25em;
    text-transform:uppercase; font-weight:600; color:var(--flame); margin-bottom:18px;
  }
  h1,h2,h3{font-family:'Fraunces',serif; font-weight:400; letter-spacing:-.01em;}
  h1{font-size:clamp(38px,6vw,66px); line-height:1.08;}
  .hero-copy{max-width:660px; margin:24px auto 0; color:var(--muted); font-size:17px;}
  .back-link{
    display:inline-flex; align-items:center; gap:9px; min-height:44px; margin-top:28px;
    font-family:'Cinzel',serif; font-size:10.5px; letter-spacing:.14em; text-transform:uppercase;
    font-weight:600; color:var(--flame); border-bottom:1px solid rgba(193,85,44,.3);
  }
  .back-link::before{content:'\2190'; font-family:'Karla',sans-serif; font-size:17px;}

  .initiative-nav{padding:30px 0; background:rgba(255,255,255,.38); border-block:1px solid rgba(36,27,46,.08);}
  .initiative-nav .wrap{display:flex; flex-wrap:wrap; justify-content:center; gap:10px;}
  .initiative-nav a{
    display:inline-flex; align-items:center; min-height:42px; padding:8px 15px;
    border:1px solid rgba(169,131,47,.25); border-radius:999px;
    font-size:13px; color:var(--muted); background:rgba(247,241,230,.7);
    transition:background .2s ease,color .2s ease,border-color .2s ease;
  }
  .initiative-nav a:hover{background:var(--ink); border-color:var(--ink); color:var(--cream-text);}

  main{background:linear-gradient(180deg,var(--parchment) 0%,#FBF8F1 46%,var(--parchment) 100%);}
  .initiatives{padding:88px 0 100px;}
  .section-intro{max-width:700px; margin:0 auto 64px; text-align:center;}
  .section-intro h2{font-size:clamp(30px,4.5vw,46px); line-height:1.14;}
  .section-intro p{color:var(--muted); margin-top:18px; font-size:16px;}
  .initiative-list{max-width:880px; margin:0 auto; position:relative;}
  .initiative-list::before{
    content:''; position:absolute; left:31px; top:20px; bottom:20px; width:1px;
    background:linear-gradient(180deg,rgba(193,85,44,.55),rgba(169,131,47,.28));
  }
  .initiative{
    position:relative; scroll-margin-top:110px; margin-bottom:34px; padding:38px 40px 36px 92px;
    background:
      radial-gradient(circle at 100% 0%,rgba(169,131,47,.1),transparent 38%),
      rgba(255,255,255,.64);
    border:1px solid rgba(36,27,46,.09); border-top-color:rgba(169,131,47,.35);
    border-radius:16px; box-shadow:0 16px 42px rgba(36,27,46,.055);
  }
  .initiative:last-child{margin-bottom:0;}
  .initiative-mark{
    position:absolute; left:13px; top:38px; width:38px; height:38px; display:grid; place-items:center;
    border:1px solid rgba(193,85,44,.45); border-radius:50%; background:var(--parchment);
    color:var(--flame); font-family:'Fraunces',serif; font-size:15px;
    box-shadow:0 0 0 8px var(--parchment);
  }
  .initiative-year{
    display:inline-block; font-family:'Cinzel',serif; font-size:10.5px; letter-spacing:.18em;
    text-transform:uppercase; color:var(--flame); font-weight:600; margin-bottom:8px;
  }
  .initiative h2{font-size:clamp(25px,3.4vw,36px); line-height:1.18;}
  .initiative-lead{
    margin-top:14px; color:var(--ink); font-family:'Fraunces',serif;
    font-size:clamp(17px,2vw,20px); font-style:italic; line-height:1.55;
  }
  .initiative-body{display:grid; grid-template-columns:1fr 1fr; gap:26px; margin-top:26px; padding-top:24px; border-top:1px solid rgba(36,27,46,.09);}
  .detail-label{
    display:block; font-family:'Cinzel',serif; font-size:10px; letter-spacing:.16em;
    text-transform:uppercase; color:var(--gold); font-weight:600; margin-bottom:7px;
  }
  .initiative-body p{color:var(--muted); font-size:14.5px;}

  .closing{padding:88px 0; text-align:center; background:linear-gradient(180deg,var(--teal),#274A42); color:var(--cream-text);}
  .closing .eyebrow{color:#D3AF58;}
  .closing h2{font-size:clamp(30px,4.6vw,46px); max-width:720px; margin:0 auto; line-height:1.16;}
  .closing p{max-width:600px; margin:20px auto 0; color:#D6CEC1;}
  .closing-actions{display:flex; flex-wrap:wrap; justify-content:center; gap:14px; margin-top:30px;}
  .closing-actions a{
    display:inline-flex; align-items:center; justify-content:center; min-height:48px; padding:12px 24px;
    font-family:'Cinzel',serif; font-size:10.5px; letter-spacing:.14em; text-transform:uppercase;
    font-weight:600; border:1px solid rgba(239,231,216,.55);
  }
  .closing-actions .primary{background:var(--cream-text); color:var(--teal); border-color:var(--cream-text);}

  @media(max-width:700px){
    .wrap{padding:0 20px;}
    .initiatives-hero{padding:124px 0 68px;}
    .initiative-nav .wrap{justify-content:flex-start; flex-wrap:nowrap; overflow-x:auto; padding-bottom:5px;}
    .initiative-nav a{white-space:nowrap;}
    .initiatives{padding:68px 0 76px;}
    .section-intro{margin-bottom:48px;}
    .initiative-list::before{left:19px;}
    .initiative{padding:30px 22px 28px 58px; border-radius:13px;}
    .initiative-mark{left:2px; top:30px; width:34px; height:34px; box-shadow:0 0 0 6px var(--parchment);}
    .initiative-body{grid-template-columns:1fr; gap:18px;}
    .closing{padding:70px 0;}
  }
  @media(prefers-reduced-motion:reduce){
    *{animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important; scroll-behavior:auto !important;}
  }
</style>
