---
layout: base.njk
pagination:
  data: newsEventDetails
  size: 1
  alias: event
permalink: "/news-events/{{ event.id }}/"
eleventyComputed:
  title: "{{ event.hi.title }} | मणिद्वीप अध्यात्म परिवार"
  description: "{{ event.hi.description }}"
bodyClass: "hindi-home news-events-page page-transparent-hero"
breadcrumb: true
breadcrumbParent: { "label": "समाचार एवं कार्यक्रम", "href": "/news-events/" }
extraCss: ["/assets/css/news-events.css"]
extraJs: ["/assets/js/news-event-detail.js"]
---
<main id="main-content">
    <section class="page-hero page-hero--plain" aria-labelledby="event-detail-title">
        <div class="hi-shell page-hero__content">
            <span class="hi-kicker">{{ event.hi.meta }}</span>
            <h1 id="event-detail-title">{{ event.hi.title }}</h1>
            <p class="page-hero__lead">{{ event.hi.description }}</p>
        </div>
    </section>

    <section class="news-events-section">
        <div class="hi-shell news-event-brief{% if not event.detail.photos.length %} news-event-brief--no-photos{% endif %}">
            <div class="hi-prose news-event-brief__text">
                {%- for para in event.detail.brief.hi %}
                <p>{{ para }}</p>
                {%- endfor %}
            </div>
            {%- if event.detail.photos.length %}
            <div class="news-event-brief__photos" aria-label="कार्यक्रम की तस्वीरें" data-lightbox-grid>
                {%- for photo in event.detail.photos %}
                <button class="news-event-brief__photo" type="button" data-lightbox-image="{{ photo.src | url }}" data-lightbox-title="{{ photo.alt.hi }}">
                    <img src="{{ photo.card | url }}" alt="{{ photo.alt.hi }}" loading="lazy">
                </button>
                {%- endfor %}
            </div>
            {%- endif %}
        </div>
    </section>

    {%- if event.detail.clippings.length %}
    <section class="news-events-section" aria-labelledby="event-clippings-title">
        <div class="hi-shell">
            <header class="hi-section-heading hi-section-heading--center">
                <span class="hi-kicker">समाचार संग्रह</span>
                <h2 id="event-clippings-title">समाचार पत्रों में</h2>
            </header>
            <div class="news-clips-grid" data-lightbox-grid>
                {%- for clip in event.detail.clippings %}
                <button class="news-clip-card" type="button" data-lightbox-image="{{ clip.src | url }}" data-lightbox-title="{{ clip.alt.hi }}">
                    <figure class="news-clip-card__image">
                        <img src="{{ clip.card | url }}" alt="{{ clip.alt.hi }}" loading="lazy">
                    </figure>
                </button>
                {%- endfor %}
            </div>
        </div>
    </section>
    {%- endif %}

    <section class="news-events-section">
        <div class="hi-shell hi-actions hi-actions--center">
            <a class="hi-btn hi-btn--outline" href="{{ '/news-events/' | url }}">सभी समाचार एवं कार्यक्रम देखें</a>
        </div>
    </section>
</main>

<div class="news-modal" data-news-modal role="dialog" aria-modal="true" aria-labelledby="news-modal-title">
    <div class="news-modal__dialog">
        <div class="news-modal__head">
            <h2 class="news-modal__title" id="news-modal-title" data-news-modal-title></h2>
            <button class="news-modal__close" type="button" data-news-close aria-label="बन्द करें">×</button>
        </div>
        <div class="news-modal__body"><img data-news-modal-image alt=""></div>
    </div>
</div>
