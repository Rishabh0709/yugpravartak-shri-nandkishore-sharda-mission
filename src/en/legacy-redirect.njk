---
pagination:
  data: legacyRedirects.en
  size: 1
  alias: slug
permalink: "/en/{{ slug }}.html"
eleventyExcludeFromCollections: true
---
{%- set target = '/en/' + slug + '/' -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Redirecting&hellip;</title>
<link rel="canonical" href="{{ target | url }}">
<meta http-equiv="refresh" content="0; url={{ target | url }}">
<meta name="robots" content="noindex, nofollow">
<style>body{font:16px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif;margin:15vh auto;max-width:32rem;padding:0 1.25rem;color:#574d44}a{color:#7b2a28}</style>
</head>
<body>
<p>This page has moved to a new address. Taking you there&hellip;</p>
<p>If you are not redirected, <a href="{{ target | url }}">continue here</a>.</p>
<script>location.replace({{ (target | url) | dump | safe }});</script>
</body>
</html>
