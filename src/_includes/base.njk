{%- set locale = locale or "hi" -%}
{%- set L = site.locales[locale] -%}
<!DOCTYPE html>
<html lang="{{ L.htmlLang }}">
<head>
{% include "partials/head.njk" %}
</head>
<body class="{{ bodyClass or 'hindi-home' }}">
    <a class="skip-link" href="#main-content">{{ "मुख्य सामग्री पर जाएँ" if locale == "hi" else "Skip to main content" }}</a>
    <div id="header-placeholder">{% include "partials/header.njk" %}</div>

{{ content | safe }}

    <div id="footer-placeholder">{% include "partials/footer.njk" %}</div>
{% include "partials/scripts.njk" %}
</body>
</html>
