.trust-detail-page {
    --trust-blue: #355c87;
    --trust-blue-deep: #263f62;
    --trust-rose: #a84f51;
}

.trust-detail-page .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

.trust-hero {
    background:
        radial-gradient(circle at 8% 12%, rgba(53, 92, 135, 0.15), transparent 30%),
        radial-gradient(circle at 90% 82%, rgba(200, 161, 59, 0.16), transparent 34%),
        linear-gradient(180deg, #fbf8f1, #e8e3d9);
}

.trust-hero::after {
    border-color: rgba(53, 92, 135, 0.15);
}

.trust-hero .detail-hero-lead {
    border-left-color: rgba(53, 92, 135, 0.42);
}

.trust-index {
    position: sticky;
    z-index: 40;
    top: 84px;
    border-top: 1px solid rgba(53, 92, 135, 0.09);
    border-bottom: 1px solid rgba(53, 92, 135, 0.12);
    background: rgba(250, 247, 241, 0.94);
    backdrop-filter: blur(16px);
}

.trust-index-inner {
    display: flex;
    min-height: 58px;
    align-items: center;
    gap: 25px;
    overflow-x: auto;
    scrollbar-width: none;
}

.trust-index-inner::-webkit-scrollbar {
    display: none;
}

.trust-index-inner > span {
    flex: 0 0 auto;
    color: var(--trust-blue);
    font-family: "Cinzel", serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
}

.trust-index a {
    position: relative;
    flex: 0 0 auto;
    padding: 18px 0 17px;
    color: var(--activity-muted);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
}

.trust-index a::after {
    position: absolute;
    right: 0;
    bottom: 11px;
    left: 0;
    height: 1px;
    content: "";
    background: var(--trust-blue);
    transform: scaleX(0);
    transition: transform 220ms ease;
}

.trust-index a:hover {
    color: var(--trust-blue);
}

.trust-index a:hover::after {
    transform: scaleX(1);
}

.trust-detail-page section[id] {
    scroll-margin-top: 160px;
}

.trust-intro {
    max-width: 900px;
}

.trust-origin-story {
    align-items: center;
}

.trust-photo-wide img {
    object-position: center;
}

.trust-principles {
    background:
        radial-gradient(circle at 88% 0%, rgba(212, 174, 93, 0.17), transparent 31%),
        linear-gradient(145deg, var(--trust-blue-deep), #1f334f);
}

.trust-process-section {
    padding: 100px 0;
    background:
        radial-gradient(circle at 8% 12%, rgba(53, 92, 135, 0.08), transparent 24%),
        linear-gradient(180deg, #faf7f1, #f2ece1);
}

.trust-process {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    counter-reset: trust-step;
}

.trust-process li {
    display: grid;
    min-height: 225px;
    padding: 31px;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 20px;
    border: 1px solid rgba(53, 92, 135, 0.14);
    border-radius: 17px;
    background: rgba(255, 255, 255, 0.64);
    box-shadow: 0 16px 42px rgba(39, 49, 61, 0.05);
}

.trust-process-number {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    color: var(--trust-blue);
    border: 1px solid rgba(53, 92, 135, 0.28);
    border-radius: 50%;
    font-family: "Fraunces", serif;
    font-size: 18px;
}

.trust-process strong {
    display: block;
    margin-bottom: 9px;
    font-family: "Fraunces", serif;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.25;
}

.trust-process p {
    color: var(--activity-muted);
    font-size: 16px;
    line-height: 1.7;
}

.trust-eligibility {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 34px;
    overflow: hidden;
    border: 1px solid rgba(53, 92, 135, 0.16);
    border-radius: 17px;
    background: rgba(53, 92, 135, 0.055);
}

.trust-eligibility div {
    padding: 24px 25px;
}

.trust-eligibility div + div {
    border-left: 1px solid rgba(53, 92, 135, 0.14);
}

.trust-eligibility span {
    display: block;
    margin-bottom: 6px;
    color: var(--trust-blue);
    font-family: "Cinzel", serif;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.trust-eligibility strong {
    font-family: "Fraunces", serif;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.42;
}

.trust-everyday {
    background: #fbf8f2;
}

.trust-support-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 72px;
    gap: 16px;
}

.trust-support-grid article {
    min-height: 205px;
    padding: 28px 27px;
    border: 1px solid rgba(53, 92, 135, 0.13);
    border-radius: 15px;
    background: rgba(255, 255, 255, 0.58);
}

.trust-support-grid span {
    display: block;
    margin-bottom: 9px;
    color: var(--trust-blue);
    font-family: "Fraunces", serif;
    font-size: 21px;
    font-weight: 500;
}

.trust-support-grid p {
    color: var(--activity-muted);
    font-size: 15px;
    line-height: 1.7;
}

.trust-impact {
    padding: 102px 0;
    color: #f7f2e9;
    background:
        radial-gradient(circle at 12% 8%, rgba(200, 161, 59, 0.16), transparent 25%),
        linear-gradient(145deg, #242b36, #18222f);
}

.trust-impact-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(300px, 0.7fr);
    gap: clamp(40px, 7vw, 90px);
    align-items: end;
}

.trust-impact .activity-eyebrow {
    color: #d5ae59;
}

.trust-impact-heading h2 {
    margin-top: 11px;
    font-family: "Fraunces", serif;
    font-size: clamp(37px, 5vw, 55px);
    font-weight: 400;
    line-height: 1.1;
}

.trust-impact-heading p {
    color: #d4cfc6;
    font-size: 17px;
    line-height: 1.76;
}

.trust-impact-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 54px;
    overflow: hidden;
    border-top: 1px solid rgba(247, 242, 233, 0.16);
    border-bottom: 1px solid rgba(247, 242, 233, 0.16);
}

.trust-impact-grid article {
    min-height: 170px;
    padding: 32px 25px;
}

.trust-impact-grid article + article {
    border-left: 1px solid rgba(247, 242, 233, 0.14);
}

.trust-impact-grid strong {
    display: block;
    margin-bottom: 9px;
    color: #d8b45f;
    font-family: "Fraunces", serif;
    font-size: clamp(29px, 3.3vw, 43px);
    font-weight: 400;
    line-height: 1.1;
}

.trust-impact-grid span {
    color: #d7d1c7;
    font-size: 14px;
    line-height: 1.55;
}

.trust-data-panel {
    margin-top: 58px;
    padding: clamp(24px, 4vw, 42px);
    border: 1px solid rgba(247, 242, 233, 0.15);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.035);
}

.trust-data-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.66fr);
    gap: 35px;
    align-items: end;
}

.trust-data-heading h3 {
    margin-top: 8px;
    font-family: "Fraunces", serif;
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 400;
    line-height: 1.15;
}

.trust-data-heading p {
    color: #c6c0b7;
    font-size: 15px;
    line-height: 1.7;
}

.trust-data-table-wrap {
    margin-top: 35px;
    overflow-x: auto;
}

.trust-data-table {
    width: 100%;
    min-width: 650px;
    border-collapse: collapse;
    color: #ece6dc;
}

.trust-data-table th,
.trust-data-table td {
    padding: 15px 14px;
    border-bottom: 1px solid rgba(247, 242, 233, 0.11);
    text-align: left;
}

.trust-data-table thead th {
    padding-top: 10px;
    color: #b8b1a8;
    font-family: "Cinzel", serif;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.trust-data-table tbody th {
    color: #f5efe5;
    font-family: "Fraunces", serif;
    font-size: 18px;
    font-weight: 500;
}

.trust-data-table tbody td:nth-child(2) {
    color: #d6cfc5;
    font-variant-numeric: tabular-nums;
}

.trust-amount {
    position: relative;
    display: grid;
    min-width: 250px;
    min-height: 29px;
    align-items: center;
    isolation: isolate;
}

.trust-amount b {
    z-index: 1;
    padding-left: 9px;
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
}

.trust-amount i {
    position: absolute;
    z-index: -1;
    top: 3px;
    bottom: 3px;
    left: 0;
    width: var(--amount-width);
    border-radius: 4px;
    background: linear-gradient(90deg, rgba(216, 180, 95, 0.28), rgba(216, 180, 95, 0.10));
}

.trust-data-table tfoot th,
.trust-data-table tfoot td {
    padding-top: 20px;
    color: #d8b45f;
    border-bottom: 0;
    font-family: "Fraunces", serif;
    font-size: 19px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
}

.trust-data-note {
    margin-top: 18px;
    color: #aaa49b;
    font-size: 12px;
    line-height: 1.65;
}

.trust-impact-photo {
    margin-top: 54px;
}

.trust-impact-photo img {
    width: 100%;
    max-height: 600px;
    border-radius: 18px;
    object-fit: cover;
    object-position: center 42%;
}

.trust-impact-photo figcaption {
    margin-top: 12px;
    color: #aaa59d;
    font-size: 13px;
}

.trust-questions {
    padding: 100px 0;
    background: linear-gradient(180deg, #f7f2e9, #fbf8f2);
}

.trust-questions-grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.1fr);
    gap: clamp(50px, 8vw, 110px);
}

.trust-questions h2 {
    margin-top: 11px;
    font-family: "Fraunces", serif;
    font-size: clamp(35px, 4.6vw, 50px);
    font-weight: 400;
    line-height: 1.12;
}

.trust-questions header p {
    margin-top: 18px;
    color: var(--activity-muted);
    font-size: 17px;
    line-height: 1.72;
}

.trust-accordion details {
    border-top: 1px solid rgba(53, 92, 135, 0.17);
}

.trust-accordion details:last-child {
    border-bottom: 1px solid rgba(53, 92, 135, 0.17);
}

.trust-accordion summary {
    position: relative;
    padding: 22px 42px 22px 0;
    cursor: pointer;
    font-family: "Fraunces", serif;
    font-size: 21px;
    font-weight: 500;
    line-height: 1.35;
    list-style: none;
}

.trust-accordion summary::-webkit-details-marker {
    display: none;
}

.trust-accordion summary::after {
    position: absolute;
    top: 20px;
    right: 3px;
    content: "+";
    color: var(--trust-blue);
    font-family: "Karla", sans-serif;
    font-size: 25px;
    font-weight: 400;
}

.trust-accordion details[open] summary::after {
    content: "−";
}

.trust-accordion details p {
    padding: 0 38px 23px 0;
    color: var(--activity-muted);
    font-size: 16px;
    line-height: 1.72;
}

.trust-closing {
    background:
        radial-gradient(circle at 50% 100%, rgba(53, 92, 135, 0.08), transparent 36%),
        #fbf8f2;
}

@media (max-width: 940px) {
    .trust-process,
    .trust-support-grid,
    .trust-impact-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .trust-impact-grid article:nth-child(3) {
        border-left: 0;
    }

    .trust-impact-grid article:nth-child(n+3) {
        border-top: 1px solid rgba(247, 242, 233, 0.14);
    }
}

@media (max-width: 800px) {
    .trust-index {
        top: 84px;
    }

    .trust-index-inner {
        gap: 21px;
    }

    .trust-index-inner > span {
        display: none;
    }

    .trust-eligibility,
    .trust-impact-heading,
    .trust-data-heading,
    .trust-questions-grid {
        grid-template-columns: 1fr;
    }

    .trust-eligibility div + div {
        border-top: 1px solid rgba(53, 92, 135, 0.14);
        border-left: 0;
    }
}

@media (max-width: 600px) {
    .trust-process-section,
    .trust-impact,
    .trust-questions {
        padding: 74px 0;
    }

    .trust-process,
    .trust-support-grid,
    .trust-impact-grid {
        grid-template-columns: 1fr;
    }

    .trust-process li {
        min-height: 0;
        padding: 25px 22px;
        grid-template-columns: 42px minmax(0, 1fr);
        gap: 15px;
    }

    .trust-process-number {
        width: 40px;
        height: 40px;
        font-size: 16px;
    }

    .trust-process strong {
        font-size: 21px;
    }

    .trust-support-grid {
        margin-top: 52px;
    }

    .trust-support-grid article {
        min-height: 0;
    }

    .trust-impact-grid article + article,
    .trust-impact-grid article:nth-child(3) {
        border-top: 1px solid rgba(247, 242, 233, 0.14);
        border-left: 0;
    }

    .trust-impact-grid article {
        min-height: 0;
    }

    .trust-impact-photo img {
        min-height: 285px;
    }
}
