:root {
    --donation-ink: #241b2e;
    --donation-paper: #faf5ec;
    --donation-deep: #efe4d3;
    --donation-flame: #b95732;
    --donation-gold: #a47a2c;
    --donation-teal: #1f3a34;
    --donation-blue: #355c87;
    --donation-muted: #655b51;
}

body.donation-page {
    background: var(--donation-paper);
}

.donation-page h1,
.donation-page h2,
.donation-page h3 {
    font-family: "Fraunces", serif;
    font-weight: 400;
}

.donation-hero {
    position: relative;
    padding: 78px 0 92px;
    overflow: hidden;
    background:
        radial-gradient(circle at 13% 15%, rgba(185, 87, 50, 0.13), transparent 29%),
        radial-gradient(circle at 88% 82%, rgba(164, 122, 44, 0.16), transparent 31%),
        linear-gradient(145deg, #fcf8f1, var(--donation-deep));
}

.donation-hero::after {
    position: absolute;
    right: -120px;
    bottom: -260px;
    width: 540px;
    height: 540px;
    content: "";
    border: 1px solid rgba(164, 122, 44, 0.16);
    border-radius: 50%;
    box-shadow: 0 0 0 54px rgba(164, 122, 44, 0.035), 0 0 0 108px rgba(164, 122, 44, 0.022);
}

.donation-breadcrumb {
    position: relative;
    z-index: 1;
    display: flex;
    margin-bottom: 45px;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    color: #786e64;
    font-size: 13px;
}

.donation-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(290px, 0.62fr);
    align-items: end;
    gap: clamp(48px, 8vw, 112px);
}

.donation-hero h1 {
    max-width: 760px;
    margin: 12px 0 0;
    color: var(--donation-ink);
    font-size: clamp(45px, 6.3vw, 73px);
    letter-spacing: -0.025em;
    line-height: 1.02;
}

.donation-hero-copy {
    padding-left: 24px;
    color: var(--donation-muted);
    border-left: 1px solid rgba(164, 122, 44, 0.38);
    font-size: 18px;
    line-height: 1.74;
}

.donation-hero-copy strong {
    display: block;
    margin-bottom: 7px;
    color: var(--donation-ink);
    font-family: "Fraunces", serif;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.3;
}

.donation-principles {
    position: relative;
    z-index: 2;
    display: grid;
    width: min(calc(100% - 64px), var(--activity-max));
    margin: -30px auto 0;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid rgba(69, 51, 30, 0.11);
    border-radius: 16px;
    background: rgba(255, 253, 249, 0.97);
    box-shadow: 0 18px 46px rgba(47, 36, 23, 0.1);
}

.donation-principles div {
    min-height: 104px;
    padding: 23px 27px;
}

.donation-principles div + div {
    border-left: 1px solid rgba(69, 51, 30, 0.11);
}

.donation-principles span {
    display: block;
    color: var(--donation-flame);
    font-family: "Cinzel", serif;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
}

.donation-principles strong {
    display: block;
    margin-top: 7px;
    color: var(--donation-ink);
    font-family: "Fraunces", serif;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
}

.donation-section {
    padding: 98px 0;
}

.donation-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.62fr);
    align-items: end;
    gap: clamp(40px, 7vw, 90px);
}

.donation-heading h2 {
    max-width: 720px;
    margin: 10px 0 0;
    font-size: clamp(36px, 4.8vw, 54px);
    line-height: 1.1;
}

.donation-heading > p {
    margin: 0;
    color: var(--donation-muted);
    font-size: 17px;
    line-height: 1.74;
}

.donation-selector-card {
    margin-top: 48px;
    padding: clamp(25px, 4vw, 38px);
    border: 1px solid rgba(69, 51, 30, 0.12);
    border-radius: 20px;
    background: #fffdf9;
    box-shadow: 0 20px 52px rgba(49, 38, 24, 0.08);
}

.donation-selector-card label {
    display: block;
    margin-bottom: 11px;
    color: var(--donation-gold);
    font-family: "Cinzel", serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
}

.donation-select-shell {
    position: relative;
}

.donation-select-shell::after {
    position: absolute;
    top: 50%;
    right: 22px;
    width: 9px;
    height: 9px;
    content: "";
    pointer-events: none;
    border-right: 2px solid var(--donation-gold);
    border-bottom: 2px solid var(--donation-gold);
    transform: translateY(-70%) rotate(45deg);
}

.donation-selector-card select {
    width: 100%;
    min-height: 62px;
    padding: 14px 55px 14px 18px;
    cursor: pointer;
    color: var(--donation-ink);
    border: 1px solid rgba(53, 92, 135, 0.24);
    border-radius: 12px;
    outline: none;
    appearance: none;
    background: #faf7f1;
    font-family: "Fraunces", serif;
    font-size: 20px;
}

.donation-selector-card select:focus {
    border-color: var(--donation-gold);
    box-shadow: 0 0 0 4px rgba(164, 122, 44, 0.1);
}

.donation-selector-help {
    margin: 10px 0 0;
    color: #857b70;
    font-size: 13px;
}

.donation-route {
    margin-top: 22px;
    overflow: hidden;
    border: 1px solid rgba(69, 51, 30, 0.13);
    border-radius: 20px;
    background: #fffdf9;
    box-shadow: 0 24px 60px rgba(49, 38, 24, 0.09);
}

.donation-route-header {
    display: flex;
    padding: 27px 30px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    color: #f8f0e4;
    background:
        radial-gradient(circle at 92% 0%, rgba(211, 173, 92, 0.19), transparent 32%),
        var(--donation-teal);
}

.donation-route-header span {
    color: #d3ad5c;
    font-family: "Cinzel", serif;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
}

.donation-route-header h3 {
    margin: 5px 0 0;
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.2;
}

.donation-status {
    flex: 0 0 auto;
    padding: 6px 10px;
    color: #214c3c;
    border-radius: 999px;
    background: #e3f1e7;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
}

.donation-route-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.55fr);
}

.bank-details {
    padding: clamp(30px, 5vw, 54px);
}

.bank-details h3,
.upi-panel h3 {
    font-size: 27px;
    line-height: 1.2;
}

.bank-details-intro {
    margin: 11px 0 27px;
    color: var(--donation-muted);
    font-size: 15px;
    line-height: 1.7;
}

.bank-fields {
    border-top: 1px solid rgba(69, 51, 30, 0.12);
}

.bank-field {
    display: grid;
    min-height: 66px;
    padding: 13px 0;
    grid-template-columns: 150px minmax(0, 1fr) auto;
    align-items: center;
    gap: 15px;
    border-bottom: 1px solid rgba(69, 51, 30, 0.12);
}

.bank-field > span {
    color: #847a70;
    font-family: "Cinzel", serif;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
}

.bank-field strong {
    color: var(--donation-ink);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.45;
    overflow-wrap: anywhere;
}

.copy-button {
    padding: 7px 10px;
    cursor: pointer;
    color: var(--donation-blue);
    border: 1px solid rgba(53, 92, 135, 0.22);
    border-radius: 7px;
    background: #f5f7f9;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

.copy-button:hover {
    color: #fff;
    background: var(--donation-blue);
}

.copy-status {
    min-height: 22px;
    margin-top: 13px;
    color: #357058;
    font-size: 12px;
}

.donation-compliance {
    display: flex;
    margin-top: 18px;
    padding: 15px 17px;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 15px;
    border-radius: 10px;
    background: #f0f5f1;
}

.donation-compliance span {
    color: #42705d;
    font-family: "Cinzel", serif;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.donation-compliance strong {
    color: #2e5143;
    font-size: 13px;
}

.donation-compliance a {
    margin-left: auto;
    color: var(--donation-blue);
    font-size: 12px;
    font-weight: 600;
}

.upi-panel {
    padding: clamp(30px, 4.5vw, 48px);
    text-align: center;
    border-left: 1px solid rgba(69, 51, 30, 0.12);
    background: #f5ecdf;
}

.upi-qr-shell {
    width: min(100%, 285px);
    margin: 23px auto 18px;
    padding: 14px;
    border: 1px solid rgba(164, 122, 44, 0.2);
    border-radius: 18px;
    background: #fffaf1;
    box-shadow: 0 16px 36px rgba(49, 38, 24, 0.1);
}

.upi-qr-shell img {
    width: 100%;
    border-radius: 8px;
}

.upi-id {
    color: var(--donation-ink);
    font-size: 17px;
    font-weight: 700;
}

.upi-caption {
    margin: 7px auto 0;
    color: var(--donation-muted);
    font-size: 13px;
    line-height: 1.55;
}

.upi-actions {
    display: flex;
    margin-top: 20px;
    justify-content: center;
    flex-wrap: wrap;
    gap: 9px;
}

.upi-button {
    display: inline-flex;
    min-height: 42px;
    padding: 10px 15px;
    align-items: center;
    justify-content: center;
    color: #fff;
    border: 1px solid var(--donation-teal);
    border-radius: 999px;
    background: var(--donation-teal);
    font-size: 11px;
    font-weight: 700;
}

.upi-button.secondary {
    color: var(--donation-teal);
    background: transparent;
}

.donation-unavailable {
    padding: clamp(38px, 7vw, 78px);
    text-align: center;
}

.donation-unavailable[hidden],
.donation-route-grid[hidden] {
    display: none;
}

.donation-unavailable-mark {
    display: grid;
    width: 52px;
    height: 52px;
    margin: 0 auto 19px;
    place-items: center;
    color: var(--donation-gold);
    border: 1px solid rgba(164, 122, 44, 0.28);
    border-radius: 50%;
    font-family: "Fraunces", serif;
    font-size: 24px;
}

.donation-unavailable h3 {
    font-size: clamp(28px, 4vw, 39px);
}

.donation-unavailable p {
    max-width: 670px;
    margin: 13px auto 0;
    color: var(--donation-muted);
    font-size: 16px;
    line-height: 1.7;
}

.donation-contact-button {
    display: inline-flex;
    min-height: 47px;
    margin-top: 24px;
    padding: 11px 20px;
    align-items: center;
    justify-content: center;
    color: #fff;
    border-radius: 999px;
    background: var(--donation-flame);
    font-family: "Cinzel", serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.gateway-note {
    display: grid;
    margin-top: 24px;
    padding: 27px 30px;
    grid-template-columns: 46px minmax(0, 1fr);
    gap: 19px;
    color: #f8f0e4;
    border-radius: 17px;
    background:
        radial-gradient(circle at 95% 0%, rgba(211, 173, 92, 0.17), transparent 34%),
        #26323f;
}

.gateway-note-mark {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    color: #d3ad5c;
    border: 1px solid rgba(211, 173, 92, 0.32);
    border-radius: 50%;
    font-family: "Fraunces", serif;
    font-size: 23px;
}

.gateway-note strong {
    display: block;
    font-family: "Fraunces", serif;
    font-size: 22px;
    font-weight: 400;
}

.gateway-note p {
    margin: 7px 0 0;
    color: #d4cfc7;
    font-size: 15px;
    line-height: 1.7;
}

.donation-guidance {
    padding: 94px 0;
    background: #f0e6d7;
}

.donation-guidance-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 48px;
    gap: 1px;
    background: rgba(69, 51, 30, 0.12);
}

.donation-step {
    min-height: 245px;
    padding: 30px;
    background: #f8f2e8;
}

.donation-step span {
    color: var(--donation-gold);
    font-family: "Fraunces", serif;
    font-size: 27px;
}

.donation-step h3 {
    margin: 17px 0 0;
    font-size: 25px;
}

.donation-step p {
    margin: 11px 0 0;
    color: var(--donation-muted);
    font-size: 15px;
    line-height: 1.7;
}

.receipt-panel {
    display: grid;
    margin-top: 46px;
    padding: clamp(30px, 5vw, 52px);
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 40px;
    color: #f7efe3;
    border-radius: 18px;
    background: var(--donation-teal);
}

.receipt-panel h3 {
    font-size: clamp(28px, 3.8vw, 39px);
}

.receipt-panel p {
    max-width: 730px;
    margin: 12px 0 0;
    color: #cdc8c0;
    font-size: 15px;
    line-height: 1.7;
}

.receipt-button {
    display: inline-flex;
    min-height: 48px;
    padding: 12px 20px;
    align-items: center;
    justify-content: center;
    color: #203029;
    border-radius: 999px;
    background: #d3ad5c;
    font-family: "Cinzel", serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
}

.donation-safety {
    padding: 78px 0;
}

.donation-safety-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
}

.donation-safety article {
    padding: 25px;
    border-top: 1px solid rgba(164, 122, 44, 0.35);
}

.donation-safety h3 {
    font-size: 22px;
}

.donation-safety p {
    margin: 9px 0 0;
    color: var(--donation-muted);
    font-size: 14px;
    line-height: 1.68;
}

@media (max-width: 900px) {
    .donation-hero-grid,
    .donation-heading,
    .donation-route-grid {
        grid-template-columns: 1fr;
    }

    .donation-hero-copy {
        padding: 22px 0 0;
        border-top: 1px solid rgba(164, 122, 44, 0.38);
        border-left: 0;
    }

    .upi-panel {
        border-top: 1px solid rgba(69, 51, 30, 0.12);
        border-left: 0;
    }

    .receipt-panel {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 680px) {
    .donation-hero {
        padding: 58px 0 76px;
    }

    .donation-principles,
    .donation-guidance-grid,
    .donation-safety-grid {
        grid-template-columns: 1fr;
    }

    .donation-principles {
        width: min(calc(100% - 32px), var(--activity-max));
    }

    .donation-principles div {
        min-height: 0;
    }

    .donation-principles div + div {
        border-top: 1px solid rgba(69, 51, 30, 0.11);
        border-left: 0;
    }

    .donation-section,
    .donation-guidance {
        padding: 72px 0;
    }

    .donation-route-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .bank-field {
        grid-template-columns: 1fr auto;
    }

    .bank-field > span {
        grid-column: 1 / -1;
    }

    .gateway-note {
        grid-template-columns: 1fr;
    }

    .donation-step {
        min-height: 0;
    }
}
