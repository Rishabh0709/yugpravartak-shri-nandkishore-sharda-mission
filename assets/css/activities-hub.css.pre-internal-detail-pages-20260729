:root {
    --activity-ink: #241b2e;
    --activity-paper: #f8f3e9;
    --activity-paper-deep: #efe5d4;
    --activity-flame: #b95732;
    --activity-gold: #9d7627;
    --activity-teal: #244a42;
    --activity-muted: #655b51;
    --activity-line: rgba(45, 34, 29, 0.12);
    --activity-max: 1180px;
}

html {
    scroll-behavior: smooth;
}

body.activity-page {
    color: var(--activity-ink);
    background: var(--activity-paper);
    font-family: "Karla", sans-serif;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
}

.activity-page *,
.activity-page *::before,
.activity-page *::after {
    box-sizing: border-box;
}

.activity-page h1,
.activity-page h2,
.activity-page h3,
.activity-page p,
.activity-page figure {
    margin: 0;
}

.activity-page a {
    color: inherit;
    text-decoration: none;
}

.activity-page :focus-visible {
    outline: 2px solid var(--activity-flame);
    outline-offset: 4px;
}

.activity-skip-link {
    position: fixed;
    top: 10px;
    left: 12px;
    z-index: 1000;
    padding: 10px 15px;
    color: #fff;
    border-radius: 6px;
    background: var(--activity-ink);
    transform: translateY(-160%);
    transition: transform 180ms ease;
}

.activity-skip-link:focus {
    transform: translateY(0);
}

.activity-wrap {
    width: min(calc(100% - 64px), var(--activity-max));
    margin-inline: auto;
}

.activity-eyebrow {
    display: block;
    color: var(--activity-flame);
    font-family: "Cinzel", serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
}

.activity-hero {
    position: relative;
    padding: 84px 0 92px;
    overflow: hidden;
    background:
        radial-gradient(circle at 14% 18%, rgba(185, 87, 50, 0.12), transparent 30%),
        radial-gradient(circle at 88% 78%, rgba(157, 118, 39, 0.14), transparent 32%),
        linear-gradient(180deg, #fbf7ef, var(--activity-paper-deep));
}

.activity-hero::after {
    position: absolute;
    right: -120px;
    bottom: -270px;
    width: 620px;
    height: 620px;
    content: "";
    border: 1px solid rgba(157, 118, 39, 0.16);
    border-radius: 50%;
}

.activity-breadcrumb {
    position: relative;
    z-index: 1;
    display: flex;
    margin-bottom: 54px;
    align-items: center;
    gap: 10px;
    color: var(--activity-muted);
    font-size: 14px;
}

.activity-breadcrumb a {
    color: var(--activity-flame);
}

.activity-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.65fr);
    gap: clamp(48px, 8vw, 108px);
    align-items: end;
}

.activity-hero h1 {
    max-width: 780px;
    margin-top: 15px;
    font-family: "Fraunces", serif;
    font-size: clamp(48px, 7.4vw, 82px);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.99;
}

.activity-hero-copy {
    padding-left: 26px;
    color: var(--activity-muted);
    border-left: 1px solid rgba(157, 118, 39, 0.4);
    font-size: 19px;
    line-height: 1.75;
}

.activity-hero-copy strong {
    display: block;
    margin-bottom: 11px;
    color: var(--activity-ink);
    font-family: "Fraunces", serif;
    font-size: 25px;
    font-weight: 400;
    line-height: 1.3;
}

.activity-principles {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 68px;
    border-top: 1px solid rgba(157, 118, 39, 0.22);
    border-bottom: 1px solid rgba(157, 118, 39, 0.22);
}

.activity-principle {
    padding: 20px 18px;
    color: var(--activity-muted);
    font-size: 14px;
    text-align: center;
}

.activity-principle + .activity-principle {
    border-left: 1px solid rgba(157, 118, 39, 0.22);
}

.activity-principle strong {
    display: block;
    color: var(--activity-gold);
    font-family: "Fraunces", serif;
    font-size: 22px;
    font-weight: 500;
}

.activity-index {
    padding: 26px 0;
    border-bottom: 1px solid var(--activity-line);
    background: rgba(255, 255, 255, 0.42);
}

.activity-index-inner {
    display: flex;
    align-items: center;
    gap: 18px;
}

.activity-index-label {
    flex: 0 0 auto;
    color: var(--activity-gold);
    font-family: "Cinzel", serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
}

.activity-index-links {
    display: flex;
    padding: 3px;
    overflow-x: auto;
    gap: 9px;
    scrollbar-width: thin;
}

.activity-index a {
    display: inline-flex;
    min-height: 40px;
    padding: 8px 14px;
    align-items: center;
    flex: 0 0 auto;
    color: var(--activity-muted);
    border: 1px solid rgba(157, 118, 39, 0.24);
    border-radius: 999px;
    background: rgba(248, 243, 233, 0.74);
    font-size: 13px;
    transition: color 180ms ease, background 180ms ease, border-color 180ms ease;
}

.activity-index a:hover {
    color: #fffaf2;
    border-color: var(--activity-ink);
    background: var(--activity-ink);
}

.activity-section {
    padding: 100px 0;
}

.activity-section-header {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(300px, 0.55fr);
    margin-bottom: 54px;
    gap: clamp(40px, 7vw, 90px);
    align-items: end;
}

.activity-section-header h2 {
    margin-top: 12px;
    font-family: "Fraunces", serif;
    font-size: clamp(38px, 5vw, 58px);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.08;
}

.activity-section-header p {
    color: var(--activity-muted);
    font-size: 18px;
    line-height: 1.72;
}

.trust-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
}

.trust-card {
    position: relative;
    min-height: 390px;
    padding: clamp(30px, 4vw, 46px);
    overflow: hidden;
    scroll-margin-top: 120px;
    border: 1px solid rgba(45, 34, 29, 0.1);
    border-top-color: rgba(157, 118, 39, 0.42);
    border-radius: 22px;
    background:
        radial-gradient(circle at 100% 0%, rgba(157, 118, 39, 0.11), transparent 34%),
        rgba(255, 255, 255, 0.55);
    box-shadow: 0 18px 50px rgba(36, 27, 46, 0.055);
}

.trust-card::after {
    position: absolute;
    right: -72px;
    bottom: -95px;
    width: 220px;
    height: 220px;
    content: "";
    border: 1px solid rgba(157, 118, 39, 0.12);
    border-radius: 50%;
}

.anchor-alias {
    position: absolute;
    top: -120px;
}

.trust-card-top {
    display: flex;
    margin-bottom: 36px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
}

.trust-number {
    color: var(--activity-gold);
    font-family: "Fraunces", serif;
    font-size: 27px;
}

.trust-year {
    color: var(--activity-flame);
    font-family: "Cinzel", serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
}

.trust-card h3 {
    position: relative;
    z-index: 1;
    max-width: 470px;
    font-family: "Fraunces", serif;
    font-size: clamp(27px, 3.4vw, 37px);
    font-weight: 400;
    line-height: 1.18;
}

.trust-focus {
    position: relative;
    z-index: 1;
    margin: 15px 0 19px;
    color: var(--activity-flame);
    font-weight: 600;
}

.trust-card p {
    position: relative;
    z-index: 1;
    max-width: 560px;
    color: var(--activity-muted);
    font-size: 17px;
    line-height: 1.7;
}

.trust-tags {
    position: relative;
    z-index: 1;
    display: flex;
    margin-top: 25px;
    flex-wrap: wrap;
    gap: 8px;
}

.trust-tags span {
    padding: 6px 10px;
    color: var(--activity-muted);
    border: 1px solid rgba(157, 118, 39, 0.19);
    border-radius: 999px;
    font-size: 12px;
}

.activity-bridge {
    padding: 72px 0;
    color: #f7f0e6;
    background:
        radial-gradient(circle at 85% 0%, rgba(211, 173, 92, 0.18), transparent 30%),
        linear-gradient(150deg, var(--activity-teal), #1f3d37);
}

.activity-bridge-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(300px, 1fr);
    gap: clamp(42px, 8vw, 110px);
    align-items: center;
}

.activity-bridge h2 {
    font-family: "Fraunces", serif;
    font-size: clamp(34px, 4.8vw, 52px);
    font-weight: 400;
    line-height: 1.14;
}

.activity-bridge p {
    color: #ddd4c8;
    font-size: 18px;
    line-height: 1.78;
}

.activity-bridge .activity-eyebrow {
    margin-bottom: 12px;
    color: #d3ad5c;
}

.practice-section {
    padding: 108px 0 94px;
    background: linear-gradient(180deg, #fbf8f2, var(--activity-paper));
}

.practice-list {
    border-top: 1px solid var(--activity-line);
}

.practice-item {
    position: relative;
    display: grid;
    grid-template-columns: minmax(310px, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(42px, 8vw, 100px);
    padding: 72px 0;
    align-items: center;
    scroll-margin-top: 120px;
    border-bottom: 1px solid var(--activity-line);
}

.practice-item.is-reversed {
    grid-template-columns: minmax(0, 1.08fr) minmax(310px, 0.92fr);
}

.practice-item.is-reversed .practice-copy {
    order: -1;
}

.practice-figure {
    padding: 11px;
    border: 1px solid rgba(157, 118, 39, 0.2);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.58);
    box-shadow: 0 18px 44px rgba(36, 27, 46, 0.07);
}

.practice-figure img {
    display: block;
    width: 100%;
    height: clamp(290px, 34vw, 440px);
    border-radius: 12px;
    object-fit: cover;
}

.practice-figure figcaption {
    padding: 12px 5px 2px;
    color: var(--activity-muted);
    font-size: 13px;
    line-height: 1.45;
}

.practice-order {
    color: var(--activity-gold);
    font-family: "Fraunces", serif;
    font-size: 18px;
    font-style: italic;
}

.practice-copy h3 {
    margin: 10px 0 18px;
    font-family: "Fraunces", serif;
    font-size: clamp(31px, 4.2vw, 45px);
    font-weight: 400;
    line-height: 1.14;
}

.practice-copy p {
    color: var(--activity-muted);
    font-size: 18px;
    line-height: 1.76;
    text-align: justify;
    hyphens: auto;
}

.practice-copy p + p {
    margin-top: 17px;
}

.practice-meta {
    display: flex;
    margin-top: 25px;
    padding-top: 19px;
    flex-wrap: wrap;
    gap: 10px 22px;
    border-top: 1px solid var(--activity-line);
}

.practice-meta span,
.practice-source {
    color: var(--activity-flame);
    font-size: 14px;
    font-weight: 600;
}

.practice-source {
    display: inline-flex;
    margin-top: 22px;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid rgba(185, 87, 50, 0.3);
}

.practice-source::after {
    content: "↗";
}

.activity-visual-textile {
    position: relative;
    display: grid;
    min-height: 430px;
    padding: 45px;
    overflow: hidden;
    place-items: center;
    color: #fff8ee;
    border-radius: 20px;
    background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.04) 25%, transparent 25%) 0 0 / 38px 38px,
        linear-gradient(315deg, rgba(255, 255, 255, 0.04) 25%, transparent 25%) 0 0 / 38px 38px,
        linear-gradient(145deg, #913f34, #b65b3c);
    box-shadow: 0 20px 48px rgba(72, 37, 30, 0.18);
    text-align: center;
}

.activity-visual-textile::before,
.activity-visual-textile::after {
    position: absolute;
    width: 260px;
    height: 260px;
    content: "";
    border: 1px solid rgba(255, 239, 217, 0.25);
    border-radius: 50%;
}

.activity-visual-textile::before {
    top: -110px;
    left: -90px;
}

.activity-visual-textile::after {
    right: -100px;
    bottom: -120px;
}

.activity-visual-textile span {
    position: relative;
    z-index: 1;
    max-width: 320px;
    font-family: "Fraunces", serif;
    font-size: clamp(35px, 4vw, 48px);
    font-style: italic;
    font-weight: 300;
    line-height: 1.2;
}

.activity-closing {
    padding: 92px 0 100px;
    text-align: center;
}

.activity-closing-inner {
    max-width: 820px;
    margin: 0 auto;
}

.activity-closing h2 {
    margin-top: 12px;
    font-family: "Fraunces", serif;
    font-size: clamp(36px, 5vw, 54px);
    font-weight: 400;
    line-height: 1.12;
}

.activity-closing p {
    max-width: 650px;
    margin: 20px auto 0;
    color: var(--activity-muted);
    font-size: 18px;
}

.activity-actions {
    display: flex;
    margin-top: 30px;
    justify-content: center;
    flex-wrap: wrap;
    gap: 13px;
}

.activity-button {
    display: inline-flex;
    min-height: 50px;
    padding: 13px 23px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--activity-ink);
    border-radius: 999px;
    font-family: "Cinzel", serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
}

.activity-button.primary {
    color: #fffaf2;
    border-color: var(--activity-flame);
    background: var(--activity-flame);
}

@media (max-width: 860px) {
    .activity-wrap {
        width: min(calc(100% - 40px), 760px);
    }

    .activity-hero-grid,
    .activity-section-header,
    .activity-bridge-grid,
    .practice-item,
    .practice-item.is-reversed {
        grid-template-columns: 1fr;
    }

    .activity-hero-copy {
        max-width: 680px;
    }

    .activity-principles {
        grid-template-columns: repeat(2, 1fr);
    }

    .activity-principle:nth-child(3) {
        border-top: 1px solid rgba(157, 118, 39, 0.22);
        border-left: 0;
    }

    .activity-principle:nth-child(4) {
        border-top: 1px solid rgba(157, 118, 39, 0.22);
    }

    .trust-grid {
        grid-template-columns: 1fr;
    }

    .trust-card {
        min-height: 0;
    }

    .practice-item.is-reversed .practice-copy {
        order: 0;
    }

    .practice-figure {
        width: min(100%, 680px);
        margin: 0 auto;
    }
}

@media (max-width: 560px) {
    .activity-wrap {
        width: min(calc(100% - 32px), 700px);
    }

    .activity-hero {
        padding: 58px 0 70px;
    }

    .activity-breadcrumb {
        margin-bottom: 38px;
    }

    .activity-hero h1 {
        font-size: clamp(43px, 13vw, 62px);
    }

    .activity-hero-copy {
        padding-left: 18px;
        font-size: 17px;
    }

    .activity-principles {
        margin-top: 48px;
    }

    .activity-principle {
        padding: 16px 10px;
        font-size: 12px;
    }

    .activity-index-inner {
        display: block;
    }

    .activity-index-label {
        display: block;
        margin: 0 0 10px 3px;
    }

    .activity-section,
    .practice-section {
        padding: 76px 0;
    }

    .activity-section-header {
        margin-bottom: 38px;
    }

    .trust-card {
        padding: 30px 24px;
        border-radius: 17px;
    }

    .trust-card p,
    .practice-copy p,
    .activity-bridge p {
        font-size: 17px;
        text-align: left;
    }

    .activity-bridge {
        padding: 60px 0;
    }

    .practice-item {
        gap: 28px;
        padding: 54px 0;
    }

    .practice-figure img {
        height: 290px;
    }

    .activity-visual-textile {
        min-height: 320px;
    }

    .activity-closing {
        padding: 72px 0 82px;
    }
}

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    .activity-index a,
    .activity-skip-link {
        transition: none;
    }
}
